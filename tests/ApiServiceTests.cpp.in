#include "ApiService.h"
#include <cstdlib>
#include <iostream>
#include <string>
using namespace AcApiV1;
namespace {
class FakeBackend final : public Backend {
public:
    bool ready = true; std::string lastOperation; std::string lastUsername; std::string lastPassword; std::string lastKey; std::uint32_t lastAccountId = 0; PlayerAudience lastAudience = PlayerAudience::All;
    bool IsReady() const override { return ready; }
    Json Capabilities() const override { return {{"api_version", "v1"}}; }
    Response InspectAccount(std::string const& username) override { lastOperation = "inspect"; lastUsername = username; return {200, {{"username", username}}}; }
    Response CreateAccount(std::string const& username, std::string const& password, std::string const& key) override { lastOperation = "create"; lastUsername = username; lastPassword = password; lastKey = key; return {201, {{"id", 42}}}; }
    Response ResetPassword(std::uint32_t id, std::string const& key) override { lastOperation = "reset"; lastAccountId = id; lastKey = key; return {200, {{"id", id}}}; }
    Response SuspendAccount(std::uint32_t id, std::string const& key) override { lastOperation = "suspend"; lastAccountId = id; lastKey = key; return {200, {{"id", id}}}; }
    Response RestoreAccount(std::uint32_t id, std::string const& key) override { lastOperation = "restore"; lastAccountId = id; lastKey = key; return {200, {{"id", id}}}; }
    Response CharacterStats(std::uint32_t id) override { lastOperation = "character"; return {200, {{"character_id", id}}}; }
    Response GuildStats(std::uint32_t id, std::size_t limit, std::size_t offset) override { lastOperation = "guild"; return {200, {{"guild_id", id}, {"limit", limit}, {"offset", offset}}}; }
    Response RealmStatus() override { lastOperation = "realm"; return {200, {{"status", "online"}}}; }
    Response OnlinePlayers(PlayerAudience audience, std::size_t limit, std::size_t offset) override { lastOperation = "online"; lastAudience = audience; return AudienceResponse(audience, limit, offset); }
    Response PlayerLeaderboard(std::string const& metric, PlayerAudience audience, std::size_t limit, std::size_t offset) override { lastOperation = "leaderboard"; lastAudience = audience; Response response = AudienceResponse(audience, limit, offset); response.body["metric"] = metric; return response; }
private:
    static Response AudienceResponse(PlayerAudience audience, std::size_t limit, std::size_t offset) { Json entries = Json::array(); if (audience != PlayerAudience::Ai) entries.push_back({{"name", "Human"}, {"player_type", "human"}}); if (audience != PlayerAudience::Humans) entries.push_back({{"name", "Bot"}, {"player_type", "ai"}}); return {200, {{"audience", audience == PlayerAudience::Ai ? "ai" : audience == PlayerAudience::All ? "all" : "humans"}, {"limit", limit}, {"offset", offset}, {"entries", std::move(entries)}}}; }
};
int failures = 0;
void Expect(bool condition, std::string const& message) { if (!condition) { std::cerr << "FAIL: " << message << '\n'; ++failures; } }
Request Authorized(std::string method, std::string path, std::string token) { Request request; request.method = std::move(method); request.path = std::move(path); request.headers["authorization"] = "Bearer " + token; return request; }
}
int main() {
    FakeBackend backend;
    ServiceConfig config;
    config.accountToken = "account-secret";
    config.communityToken = "community-secret";
    config.maxBodyBytes = 128;
    config.maxPageSize = 50;
    ApiService service(config, backend);
    Request health; health.method = "GET"; health.path = "/healthz";
    Expect(service.Handle(health).status == 200, "health is public");
    Request readiness; readiness.method = "GET"; readiness.path = "/readyz"; backend.ready = false;
    Expect(service.Handle(readiness).status == 503, "readiness reflects backend"); backend.ready = true;
    Request inspect = Authorized("GET", "/v1/accounts/by-username/testuser", "account-secret");
    Response response = service.Handle(inspect);
    Expect(response.status == 200 && backend.lastUsername == "TESTUSER", "inspect normalizes valid usernames");
    Request denied = Authorized("GET", "/v1/accounts/by-username/testuser", "community-secret");
    Expect(service.Handle(denied).status == 401, "community token cannot inspect accounts");
    Request create = Authorized("POST", "/v1/accounts", "account-secret");
    create.headers["idempotency-key"] = "1234567890abcdef";
    create.body = R"({"username":"newuser","password":"validPass9!"})";
    response = service.Handle(create);
    Expect(response.status == 201 && backend.lastOperation == "create" && backend.lastUsername == "NEWUSER" && backend.lastPassword == "validPass9!", "valid account creation reaches backend");
    Request missingKey = create; missingKey.headers.erase("idempotency-key");
    Expect(service.Handle(missingKey).status == 400, "writes require idempotency keys");
    Request invalidJson = create; invalidJson.body = "{";
    Expect(service.Handle(invalidJson).status == 400, "malformed JSON is rejected");
    Request reset = Authorized("POST", "/v1/accounts/42/password-reset", "account-secret");
    reset.headers["idempotency-key"] = "abcdefghijklmnop"; response = service.Handle(reset);
    Expect(response.status == 200 && backend.lastOperation == "reset" && backend.lastAccountId == 42, "password reset route is parsed");
    Request leaderboard = Authorized("GET", "/v1/leaderboards/players", "community-secret");
    leaderboard.query = {{"metric", "playtime"}, {"limit", "500"}, {"offset", "10"}}; response = service.Handle(leaderboard);
    Expect(response.status == 200 && response.body["limit"] == 50 && response.body["offset"] == 10, "leaderboard pagination is bounded");
    Expect(backend.lastAudience == PlayerAudience::Humans, "leaderboard defaults to human players");
    Request aiLeaderboard = leaderboard; aiLeaderboard.query["audience"] = "ai";
    response = service.Handle(aiLeaderboard);
    Expect(response.status == 200 && backend.lastAudience == PlayerAudience::Ai, "AI leaderboard audience reaches backend");
    Request allLeaderboard = leaderboard; allLeaderboard.query["audience"] = "all";
    response = service.Handle(allLeaderboard);
    Expect(response.status == 200 && backend.lastAudience == PlayerAudience::All
        && response.body["entries"].size() == 2
        && response.body["entries"][0]["player_type"] == "human"
        && response.body["entries"][1]["player_type"] == "ai", "mixed leaderboard returns explicit player types");
    Request invalidAudience = leaderboard; invalidAudience.query["audience"] = "bots";
    Expect(service.Handle(invalidAudience).status == 400, "invalid leaderboard audience is rejected");
    Request onlinePlayers = Authorized("GET", "/v1/players/online", "community-secret");
    response = service.Handle(onlinePlayers);
    Expect(response.status == 200 && backend.lastOperation == "online"
        && backend.lastAudience == PlayerAudience::Humans, "online players default to humans");
    onlinePlayers.query["audience"] = "ai";
    response = service.Handle(onlinePlayers);
    Expect(response.status == 200 && backend.lastAudience == PlayerAudience::Ai, "AI online audience reaches backend");
    Request wrongScope = Authorized("GET", "/v1/leaderboards/players", "account-secret");
    Expect(service.Handle(wrongScope).status == 401, "account token cannot read community data");
    Request suspend = Authorized("POST", "/v1/accounts/42/suspend", "account-secret");
    suspend.headers["idempotency-key"] = "suspend-key-1234"; response = service.Handle(suspend);
    Expect(response.status == 200 && backend.lastOperation == "suspend", "suspend route reaches backend");
    Request restore = Authorized("POST", "/v1/accounts/42/restore", "account-secret");
    restore.headers["idempotency-key"] = "restore-key-12345"; response = service.Handle(restore);
    Expect(response.status == 200 && backend.lastOperation == "restore", "restore route reaches backend");
    Request character = Authorized("GET", "/v1/characters/7", "community-secret");
    Expect(service.Handle(character).status == 200 && backend.lastOperation == "character", "character route reaches backend");
    Request guild = Authorized("GET", "/v1/guilds/9", "community-secret");
    guild.query = {{"limit", "10"}, {"offset", "5"}}; response = service.Handle(guild);
    Expect(response.status == 200 && response.body["limit"] == 10, "guild route parses pagination");
    Request realm = Authorized("GET", "/v1/realm/status", "community-secret");
    Expect(service.Handle(realm).status == 200 && backend.lastOperation == "realm", "realm route reaches backend");
    Request invalidPagination = leaderboard; invalidPagination.query["offset"] = "-1";
    Expect(service.Handle(invalidPagination).status == 400, "signed pagination is rejected");
    Request invalidType = create; invalidType.body = R"({"username":42})";
    Expect(service.Handle(invalidType).status == 400, "non-string account fields are rejected");
    Request unknown = Authorized("POST", "/v1/accounts/42/unknown", "account-secret");
    unknown.headers["idempotency-key"] = "unknown-key-12345";
    Expect(service.Handle(unknown).status == 404, "unsupported account operation is explicit");
    Request oversized = create; oversized.body = std::string(129, 'x');
    Expect(service.Handle(oversized).status == 413, "request bodies are bounded");
    Expect(ApiService::IsValidUsername("ABC123"), "valid username accepted");
    Expect(!ApiService::IsValidUsername("ABC_123"), "username punctuation rejected");
    Expect(!ApiService::IsValidPassword("short"), "short password rejected");
    Expect(ApiService::IsValidPassword("longEnough9!"), "valid password accepted");
    if (failures != 0) return EXIT_FAILURE;
    std::cout << "All ApiService tests passed\n";
    return EXIT_SUCCESS;
}
